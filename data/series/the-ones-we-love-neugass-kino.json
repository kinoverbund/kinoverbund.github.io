 },
 "about": {
  "text": "Have you always wanted to see your favorite movie on the big screen? Did you miss the official theatrical release of “Fight Club” because you were still in diapers? Or do you simply want to see classic films and audience favorites in the theater instead of at home on your laptop screen? With The Ones We Love, that’s now possible! Vote for the movie you’d like to see in the theater or suggest movies yourself—we regularly screen the movies with the most votes! You can find more info and the current poll on The Ones We Love.",
  "lang": "en",
  "venue": "Riffraff & Houdini",
  "url": "https://www.riffraff-houdini.ch/de-ch/special/the-ones-we-love.html",
  "translated": true
 },
